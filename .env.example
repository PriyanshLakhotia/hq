# Copy to .env (ignored). Never commit real credentials.
PORT=8080
PUBLIC_URL=http://localhost:8080
DATABASE_PATH=./data/hq.db
# Generate with: npm run password
OWNER_PASSWORD_HASH=
# Exact callback URLs from your ChatGPT connector setup; comma-separated.
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# Generate: openssl rand -hex 32. Used for CSRF protection on owner consent.
COOKIE_SECRET=
# Optional, injected only into Amp subprocesses. Never enter this in chat.
AMP_API_KEY=
AMP_EXECUTOR=orb
# Set these only for executor=runner. The runner owns the work checkout.
AMP_RUNNER_ID=
AMP_RUNNER_DIR=
AMP_PROJECT=
AMP_ENABLED=false
AMP_JOB_TIMEOUT_MS=1800000
