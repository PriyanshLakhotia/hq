# Local development only. .env is ignored and excluded from container builds.
PORT=8080
PUBLIC_URL=http://localhost:8080
TIME_ZONE=UTC
# Generate using npm run password; put the result here privately.
OWNER_PASSWORD_HASH=
# Generate using openssl rand -hex 32. Preserve across deployments.
COOKIE_SECRET=
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect

# Memory is temporary and development-only. Cloud Run rejects it.
STORAGE_BACKEND=memory
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)
FIRESTORE_PREFIX=hq
# Optional for local development against an emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8787

AMP_ENABLED=false
AMP_API_KEY= # Set privately when enabling Amp.
AMP_EXECUTOR=orb
AMP_PROJECT=
AMP_RUNNER_ID=
AMP_RUNNER_DIR=
# Observation limits, separate from Amp's own account/credit charges.
AMP_JOB_TIMEOUT_MS=600000
AMP_MAX_JOBS_PER_DAY=10
AMP_DAILY_BUDGET_SECONDS=1800

# manual is for local tests; cloudtasks is required on Cloud Run.
JOB_BACKEND=manual
CLOUD_TASKS_QUEUE=
TASKS_SERVICE_ACCOUNT=
