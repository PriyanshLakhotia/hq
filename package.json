{
  "name": "hq-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal MCP server for lists and Amp.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "password": "node scripts/password.mjs"
  },
  "dependencies": {
    "@ampcode/sdk": "0.1.0-20260918210405-g81edbf0",
    "@google-cloud/firestore": "^9.3.1",
    "@google-cloud/tasks": "^7.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^10.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
